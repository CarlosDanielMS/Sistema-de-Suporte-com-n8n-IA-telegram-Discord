    {
      "parameters": {
        "jsCode": "const formItems = $('Suporte TI').all();\n\nreturn $input.all().map((agente_item, index) => {\n  const agente = agente_item.json;\n  const form = formItems[index].json;\n\n  return {\n    json: {\n      timestamp: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n      usuario: form['Seu e-mail'] || '',\n      pergunta: form['Pergunta'] || '',\n      resposta: agente.resposta || '',\n      urgencia: agente.urgencia || 'baixa',\n      fontes: Array.isArray(agente.fontes) ? agente.fontes.join(', ') : '',\n      latencia_s: agente.latencia_s || 0,\n      tools_utilizadas: Array.isArray(agente.tools_utilizadas) ? agente.tools_utilizadas.join(', ') : ''\n    }\n  };\n});"
      },
      "id": "f7a8b9c0-d1e2-3456-7890-abcdef012345",
