# Copie este arquivo para .env e preencha os valores reais
# NUNCA versione o .env

# Groq — console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# LangSmith — smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=suporte-ia

# Discord — canal → Configurações → Integrações → Webhooks → Novo Webhook → Copiar URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN

# Google Sheets — parte da URL entre /d/ e /edit
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Telegram — @BotFather → /newbot → copie o token gerado
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ngrok — URL HTTPS gerada pelo comando: ngrok http 5678
# Necessário para o Telegram Trigger funcionar (exige HTTPS público)
N8N_WEBHOOK_URL=https://xxxx.ngrok-free.app

# PostgreSQL — banco local no Docker (pode deixar esses valores padrão)
POSTGRES_USER=suporte
POSTGRES_PASSWORD=suporte123
